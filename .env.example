# ==============================================================================
# CHEF TEKETEL - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Production Authentication Provider (Supabase Auth)
# Required for production admin authentication & password security.
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Public Anonymous API Key (safe to be used in client frontend)
# DO NOT place service_role secret keys in this file or any frontend code!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Frontend / Development Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port for the Vite development and preview server (Default: 3000)
PORT=3000

# Host binding for the Vite dev server (e.g., 0.0.0.0 or localhost)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Cloud Storage Deployment Configuration (Optional)
# Used only by the deployment script: dala-internal-upload-to-bucket.sh
# ------------------------------------------------------------------------------
# Google Cloud Platform Project ID
PROJECT_ID=your-project-id

# Deployment Fragment Identifier
FRAGMENT_ID=your-fragment-id

# Target Google Cloud Storage Bucket Name
BUCKET_NAME=your-gcs-bucket-name

# Directory containing the production build assets (Defaults to ./dist)
DIST_DIR=./dist

# Google Cloud Storage HMAC Access Key for gsutil/boto authentication
GCS_ACCESS_KEY=your-gcs-access-key

# Google Cloud Storage HMAC Secret Key
GCS_SECRET_KEY=your-gcs-secret-key
